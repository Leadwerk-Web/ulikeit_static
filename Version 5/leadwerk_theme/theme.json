{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "blue-deep", "color": "#0a0f2c", "name": "Blue Deep" },
        { "slug": "blue-primary", "color": "#0052ff", "name": "Blue Primary" },
        { "slug": "blue-light", "color": "#e8f0fe", "name": "Blue Light" },
        { "slug": "orange", "color": "#ff6b35", "name": "Orange" },
        { "slug": "orange-light", "color": "#ffa726", "name": "Orange Light" },
        { "slug": "white", "color": "#ffffff", "name": "White" },
        { "slug": "black", "color": "#0a0a0a", "name": "Black" },
        { "slug": "gray-100", "color": "#f5f5f5", "name": "Gray 100" },
        { "slug": "gray-600", "color": "#6b7280", "name": "Gray 600" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "display", "name": "Display", "fontFamily": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" },
        { "slug": "heading", "name": "Heading", "fontFamily": "'Geologica', sans-serif" },
        { "slug": "body", "name": "Body", "fontFamily": "'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Klein" },
        { "slug": "medium", "size": "1rem", "name": "Mittel" },
        { "slug": "large", "size": "1.25rem", "name": "Groß" },
        { "slug": "x-large", "size": "1.5rem", "name": "Sehr groß" }
      ]
    },
    "layout": {
      "contentSize": "100%",
      "wideSize": "100%"
    },
    "useRootPaddingAwareAlignments": false
  },
  "styles": {
    "color": { "background": "#0a0f2c", "text": "#ffffff" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.7" },
    "spacing": { "blockGap": "0", "padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" } },
    "blocks": {
      "core/group": { "spacing": { "blockGap": "0", "padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" } } },
      "core/template-part": { "spacing": { "padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" } } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
